# Documented-but-unexecuted prod path. Copy to apps/server/.env.prod.
# Used by `bun run db:view:prod` / `bun run db:studio:prod` (Drizzle Studio).

NODE_ENV=production
PORT=3010

BETTER_AUTH_URL=https://app.rootlens.io
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-long-secret

TRUSTED_ORIGINS=https://app.rootlens.io,https://appleid.apple.com
CORS_ALLOWED_ORIGINS=https://app.rootlens.io

# Transaction pooler for the app; session pooler (:5432) for Studio/migrations.
# Never use db.<ref>.supabase.co from the EC2 box (IPv6-only).
DATABASE_URL=postgresql://user:password@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@aws-1-REGION.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

APPLE_CLIENT_ID=io.rootlens.app.signin
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----"
APPLE_APP_BUNDLE_IDENTIFIER=io.rootlens.app

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=stera-uploads-prod
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
UPLOAD_URL_EXPIRY_SECONDS=86400
