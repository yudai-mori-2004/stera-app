# Copy to apps/server/.env and fill in real values. This file is safe to commit.

NODE_ENV=production
PORT=3010

BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-long-secret

TRUSTED_ORIGINS=http://localhost:3010
CORS_ALLOWED_ORIGINS=http://localhost:3010

DATABASE_URL=postgresql://user:password@localhost:6543/stera?pgbouncer=true
DIRECT_URL=postgresql://user:password@localhost:5432/stera

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

APPLE_CLIENT_ID=your.services.id
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----"
APPLE_APP_BUNDLE_IDENTIFIER=open.fpvlabs.stera
# Optional. Extra bundle id accepted as an Apple id-token audience, for device
# builds signed with a borrowed provisioning profile. Leave unset otherwise.
APPLE_DEV_BUNDLE_IDENTIFIER=

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=stera-uploads
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
UPLOAD_URL_EXPIRY_SECONDS=86400

# Optional
# DOCS_USERNAME=admin
# DOCS_PASSWORD=change-me
# R2_PUBLIC_URL=https://cdn.example.com
# LOG_LEVEL=info
# SENTRY_DSN=
# SKIP_ENV_VALIDATION=1
